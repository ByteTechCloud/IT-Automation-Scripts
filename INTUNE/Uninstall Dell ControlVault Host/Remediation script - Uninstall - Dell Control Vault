# Remediation Script - Remove Dell ControlVault Host Components Target Versions

# Ensure running as admin
if (-NOT ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
    [Security.Principal.WindowsBuiltInRole] "Administrator")) {
    Write-Host "Script must run as Administrator"
    exit 1
}

$targetVersions = @("5.14.10.10", "5.14.15.22", "5.13.11.19", "5.15.10.14", "6.2.26.36")

# Registry uninstall locations
$regPaths = @(
    "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall",
    "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall"
)

$installedApps = @()

foreach ($path in $regPaths) {
    if (Test-Path $path) {
        Get-ChildItem $path -ErrorAction SilentlyContinue | ForEach-Object {
            try {
                $app = Get-ItemProperty $_.PsPath -ErrorAction Stop
                if ($app.DisplayName -like "*Dell ControlVault Host Components*" -and
                    $targetVersions -contains $app.DisplayVersion) {
                    $installedApps += $app
                }
            } catch {
                # Skip bad registry entries
            }
        }
    }
}

foreach ($app in $installedApps) {
    Write-Host "Removing $($app.DisplayName) - $($app.DisplayVersion)"

    # Try uninstall by GUID
    if ($app.UninstallString -match "{[0-9A-F\-]+}") {
        $guid = $Matches[0]
        Start-Process "msiexec.exe" -ArgumentList "/x $guid /qn /norestart" -Wait
    } elseif ($app.UninstallString) {
        # Fallback uninstall command
        Start-Process "cmd.exe" "/c $($app.UninstallString) /quiet /norestart" -Wait
    }
}

# Remove leftover folders
$pathsToRemove = @(
    "C:\Program Files\Dell\Dell ControlVault Host Components",
    "C:\Program Files (x86)\Dell\Dell ControlVault Host Components"
)
foreach ($path in $pathsToRemove) {
    if (Test-Path $path) {
        Remove-Item -Path $path -Recurse -Force -ErrorAction SilentlyContinue
        Write-Host "Removed folder: $path"
    }
}

# Remove leftover registry keys
$regPathsToRemove = @(
    "HKLM:\SOFTWARE\Dell\Dell ControlVault Host Components",
    "HKLM:\SOFTWARE\WOW6432Node\Dell\Dell ControlVault Host Components"
)
foreach ($reg in $regPathsToRemove) {
    if (Test-Path $reg) {
        Remove-Item -Path $reg -Recurse -Force -ErrorAction SilentlyContinue
        Write-Host "Removed registry key: $reg"
    }
}

Write-Host "Remediation complete"
exit 0
